# ==============================================================================
# BreatheWay — Environment Variable Configuration Baseline
# ==============================================================================

# Node Environment ("development" | "production" | "test")
NODE_ENV=development

# Mock Mode (strictly prohibited in production)
# When true, uses deterministic mock fixtures instead of live external open APIs
USE_MOCK_PROVIDERS=false

# External Provider Base URLs
PHOTON_BASE_URL=https://photon.komoot.io
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
OSRM_BASE_URL=https://routing.openstreetmap.de/routed-foot
OPEN_METEO_BASE_URL=https://air-quality-api.open-meteo.com
OVERPASS_PRIMARY_URL=https://overpass-api.de/api/interpreter
OVERPASS_MIRROR_URL=https://overpass.private.coffee/api/interpreter

# Upstream Etiquette (mandatory identifying User-Agent for OSM / Nominatim fair use)
UPSTREAM_USER_AGENT=BreatheWay/1.0 (contact: info@breatheway.local)

# Rate Limits (requests per minute per IP)
RATE_LIMIT_ROUTES_PER_MIN=10
RATE_LIMIT_GEOCODE_PER_MIN=40
RATE_LIMIT_REVERSE_PER_MIN=20
RATE_LIMIT_AQI_PER_MIN=30

# Timeouts & Deadlines (milliseconds)
OVERPASS_SOFT_TIMEOUT_MS=12000
