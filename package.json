{
  "name": "breatheway",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "smoke:live": "tsx scripts/live-smoke.ts",
    "benchmark": "tsx scripts/benchmark.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.2",
    "clsx": "^2.1.1",
    "leaflet": "^1.9.4",
    "lru-cache": "^10.4.3",
    "lucide-react": "^1.56.0",
    "next": "16.4.0",
    "rbush": "^4.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-leaflet": "^5.0.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
